BITRIX_WEBHOOK_URL=
BITRIX_PORTAL_URL=

OPENAI_API_KEY=
# Настройки обработки голосовых сообщений
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# LLM
ANALYSIS_MODEL=gpt-5.6-luna
ANALYSIS_REASONING_EFFORT=high

#ANALYSIS_MODEL=gpt-5.6-terra
#ANALYSIS_REASONING_EFFORT=low

QUICK_HELP_MAX_OUTPUT_TOKENS=12000
FOLLOWUPS_MAX_OUTPUT_TOKENS=10000
ANALYSIS_MAX_OUTPUT_TOKENS=30000
ATTENTION_DELTA_MAX_OUTPUT_TOKENS=1600

COMMUNICATION_QUALITY_AUDIT_ENABLED=true
# Deal incremental-analysis rollout. Defaults preserve the canonical FULL path.
CONTEXT_MEMORY_OPTIMIZATION_ENABLED=false
CONTEXT_MEMORY_OPTIMIZATION_SHADOW_MODE=false
CONTEXT_MEMORY_OPTIMIZATION_FORCE_FULL_FALLBACK=true

# Incremental Deal Analysis V2: off (current route), shadow (paid comparison
# without publication), on (V2 with canonical FULL fallback).
DEAL_INCREMENTAL_V2_MODE=off
USD_RUB_RATE=90
OPENAI_LOG_PREVIEW_LINES=25
OPENAI_LOG_PREVIEW_CHARS=4000

ROP_DB_PATH=reports/rop_assistant/rop_assistant.sqlite
DAYTIME_CYCLE_ENABLED=true

# Optional comma-separated UF_* fields included in manager trajectory snapshots.
MANAGER_TRAJECTORY_DEAL_UF_FIELDS=
MANAGER_TRAJECTORY_LEAD_UF_FIELDS=
