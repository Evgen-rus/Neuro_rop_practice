# Webhook Bitrix24 для read-only REST-запросов к CRM.
BITRIX_WEBHOOK_URL=
# Базовый URL портала Bitrix24 без пути REST.
BITRIX_PORTAL_URL=
# API-ключ Wazzup для чтения доступной истории мессенджеров.
WAZZUP_API_KEY=

# API-ключ OpenAI для текстовых LLM-вызовов и транскрибации.
OPENAI_API_KEY=
# Провайдер текстовых LLM: openai или openrouter.
LLM_PROVIDER=openai
# При ошибке OpenRouter разрешить повтор через OpenAI.
LLM_FALLBACK_TO_OPENAI=true
# Тайм-аут одного запроса OpenAI в секундах.
OPENAI_REQUEST_TIMEOUT_SECONDS=600
# Модель OpenAI для транскрибации аудио; не зависит от текстовых LLM-профилей.
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Модель OpenAI для основного FULL/INCREMENTAL-анализа лидов и сделок.
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna
# Уровень reasoning основной модели анализа.
OPENAI_ANALYSIS_REASONING_EFFORT=high
# Максимум выходных токенов основного анализа.
ANALYSIS_MAX_OUTPUT_TOKENS=30000

# Модель OpenAI для semantic repair невалидного FULL-ответа.
OPENAI_REPAIR_MODEL=gpt-5.6-luna
# Уровень reasoning модели semantic repair.
OPENAI_REPAIR_REASONING_EFFORT=high
# Максимум выходных токенов semantic repair.
ANALYSIS_REPAIR_MAX_OUTPUT_TOKENS=8000

# Модель OpenAI для Manager Workspace: ситуация, Quick Help, follow-up, companion, письма и скрипты.
OPENAI_MANAGER_MODEL=gpt-5.6-luna
# Уровень reasoning модели Manager Workspace.
OPENAI_MANAGER_REASONING_EFFORT=high
# Максимум выходных токенов проекции и уточнения текущей ситуации менеджера.
MANAGER_SITUATION_MAX_OUTPUT_TOKENS=2400
# Максимум выходных токенов Quick Help / «Дожим».
QUICK_HELP_MAX_OUTPUT_TOKENS=12000
# Максимум выходных токенов идей для follow-up.
FOLLOWUPS_MAX_OUTPUT_TOKENS=10000
# Максимум выходных токенов короткого сопроводительного сообщения.
COMPANION_MAX_OUTPUT_TOKENS=1800
# Максимум выходных токенов полного сценария звонка или сообщения.
FULL_SCRIPT_MAX_OUTPUT_TOKENS=6000
# Максимум выходных токенов делового письма.
EMAIL_MAX_OUTPUT_TOKENS=2600
# Максимум выходных токенов комплекта email/message/call по выбранной стратегии.
STRATEGY_PACK_MAX_OUTPUT_TOKENS=9000
# Максимум выходных токенов подсказки к поручению РОПа; сценарий сохраняет analysis-модель.
TASK_GUIDANCE_MAX_OUTPUT_TOKENS=5000

# Отдельная модель OpenAI исследовательского контура Learning Shadow.
OPENAI_LEARNING_SHADOW_MODEL=gpt-5.6-luna
# Уровень reasoning модели Learning Shadow.
OPENAI_LEARNING_SHADOW_REASONING_EFFORT=xhigh
# Максимум выходных токенов одного ответа Learning Shadow.
LEARNING_SHADOW_MAX_OUTPUT_TOKENS=12000

# Разрешённые модели Prompt Lab через запятую; неизвестная модель отклоняется до LLM-вызова.
OPENAI_PROMPT_LAB_MODELS=gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,gpt-5.4,gpt-5.4-mini

# OpenRouter (заполняется при LLM_PROVIDER=openrouter).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_ANALYSIS_REASONING_EFFORT=low
OPENROUTER_REPAIR_MODEL=
OPENROUTER_REPAIR_REASONING_EFFORT=xhigh
OPENROUTER_MANAGER_MODEL=
OPENROUTER_MANAGER_REASONING_EFFORT=low
OPENROUTER_LEARNING_SHADOW_MODEL=
OPENROUTER_LEARNING_SHADOW_REASONING_EFFORT=xhigh
# Разрешённые OpenRouter model ids через запятую; capability map использует
# gateway-supported reasoning: none, minimal, low, medium, high, xhigh, max.
OPENROUTER_PROMPT_LAB_MODELS=

# Максимум строк безопасного preview запроса OpenAI в техническом логе.
OPENAI_LOG_PREVIEW_LINES=5
# Максимум символов безопасного preview запроса OpenAI в техническом логе.
OPENAI_LOG_PREVIEW_CHARS=4000
# Курс доллара к рублю для локальной оценки стоимости; не влияет на биллинг OpenAI.
USD_RUB_RATE=90

# Включает ежедневный аудит качества коммуникаций.
COMMUNICATION_QUALITY_AUDIT_ENABLED=true
# Разрешает INCREMENTAL-анализ сделок; false сохраняет маршрут FULL/MINI/skip.
DEAL_INCREMENTAL_ANALYSIS_ENABLED=true
# Включает автоматический дневной CRM/LLM-цикл при запуске API.
DAYTIME_CYCLE_ENABLED=false
# Число параллельных автоматических пайплайнов сделок; значения выше 4 ограничиваются до 4.
ANALYSIS_WORKER_CONCURRENCY=2

# Путь к SQLite-базе состояния ROP Assistant.
ROP_DB_PATH=reports/rop_assistant/rop_assistant.sqlite
# Дополнительные UF_* поля сделок для снимков траектории менеджера, через запятую.
MANAGER_TRAJECTORY_DEAL_UF_FIELDS=
# Дополнительные UF_* поля лидов для снимков траектории менеджера, через запятую.
MANAGER_TRAJECTORY_LEAD_UF_FIELDS=
